# WiseView local configuration. Copy to .env and edit if needed.
# The Flask app reads these directly from the process environment; it does not
# load .env automatically. Use `set`/`$env:` or export them in your shell.

# Where cutouts, frames, manifests and Gaia caches are written.
WV_DATA_DIR=./data

# SPHEREx source
WV_SPHEREX_COLLECTION=spherex_dr1
WV_SPHEREX_CUTOUT_SIZE_DEG=0.08
WV_SPHEREX_MAX_VISITS=24
WV_SPHEREX_FRAME_PIXELS=512

# Gaia DR3 TAP
WV_GAIA_TAP_URL=https://gea.esac.esa.int/tap-server/tap/sync
WV_GAIA_TABLE=gaiadr3.gaia_source

# Legacy unWISE mode (optional). Requires the index files below to exist.
WV_UNWISE_INDEX=tr_neo7_index-mjd-forward.fits
WV_UNWISE_WCS_INDEX=tr_neo4_wcs_sorted.csv
WV_UNWISE_SUBJECTS=wsubcache.csv
